
generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url = env("DATABASE_URL")
}


model estoque {
    id Int @id @default(autoincrement())
    imagem String @db.VarChar(255)
    item String @db.VarChar(255)
    quantidade Int
    status String @db.VarChar(255)
    sala String @db.VarChar(255)
    dataHora DateTime
}
